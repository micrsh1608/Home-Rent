# Copy this file to .env and fill in your own local values.
# NEVER commit .env or put real credentials in .env.example.

# --- Microsoft SQL Server (used when running with -Psqlserver / dev:sqlserver) ---
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=AnCuRental;encrypt=true;trustServerCertificate=true
# DB_USERNAME=ancu_app_user
# DB_PASSWORD=replace-with-strong-password

# --- SMTP for Email OTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Security & CORS ---
# Set SESSION_COOKIE_SECURE=true when serving over HTTPS
SESSION_COOKIE_SECURE=false
CSRF_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
